{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python 'E:\\workspace\\zoomos_v4\\.codex\\hooks\\pre_tool_use.py'",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python 'E:\\workspace\\zoomos_v4\\.codex\\hooks\\session_start.py'",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python 'E:\\workspace\\zoomos_v4\\.codex\\hooks\\notification.py' session_start",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python 'E:\\workspace\\zoomos_v4\\.codex\\hooks\\notification.py' stop",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
